# LedgerX - Environment Variables Template
# Copy this file to .env and provide your values.
# DO NOT commit real secrets or credentials to git.

# PostgreSQL Connection (Use ?sslmode=require in production)
# application.yml resolves DB_* first, with LEDGERX_DB_* supported as backward-compatible fallback aliases.
DB_URL=jdbc:postgresql://localhost:5432/ledgerx
DB_USER=ledgerx
DB_PASSWORD=ledgerx
DB_POOL_SIZE=10

# Kafka Broker Configuration
# application.yml resolves KAFKA_BOOTSTRAP first, with LEDGERX_KAFKA_BOOTSTRAP as fallback.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_JAAS_CONFIG=

# Server and Runtime Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod
