# LedgerX — Environment Variables Template
# Copy this file to .env and provide your values.
# DO NOT commit real secrets or credentials to git.

# PostgreSQL Connection (Use ?sslmode=require in production)
DB_URL=
DB_USER=
DB_PASSWORD=
LEDGERX_DB_URL=
LEDGERX_DB_USER=
LEDGERX_DB_PASSWORD=

# Kafka Broker Configuration
KAFKA_BOOTSTRAP=
LEDGERX_KAFKA_BOOTSTRAP=
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_JAAS_CONFIG=

# Server & Runtime Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod
